# Copy to .env, chmod 600, and replace all placeholders. Never commit .env.
DOMAIN=tripplanner.example.com
ACME_EMAIL=operator@example.com
TRIPPLANNER_IMAGE=ghcr.io/owner/tripplanner@sha256:replace_with_published_digest
Monitoring__Token=replace_with_at_least_32_random_bytes
# Generic HTTPS webhook accepting JSON: {service,status,issues,observedAt}.
# Choose your own notification receiver; leaving this empty logs alerts only.
ALERT_WEBHOOK_URL=
Email__Smtp__Host=smtp.example.com
Email__Smtp__Port=587
Email__Smtp__FromAddress=hello@example.com
Email__Smtp__FromName=TripPlanner
Email__Smtp__Username=replace_me
Email__Smtp__Password=replace_me
Email__Smtp__UseImplicitTls=false
